    "hyperframes:generate": "node scripts/generate-hyperframes.mjs",
    "remotion": "remotion studio src/remotion/index.ts",
    "remotion:compositions": "remotion compositions src/remotion/index.ts",
    "remotion:render": "remotion render src/remotion/index.ts IncomeStackFilm ../../docs/orgs/superpatch/customers/affiliates/initiatives/income-stack-deck/business-idea/15-media/openmontage/income-stack-deck-remotion.mp4",
    "omni:animate": "node scripts/omni-animate-plates.mjs",
